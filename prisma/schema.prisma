generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ContactStatus {
  new
  draft_generated
  draft_saved
  sent
  failed
}

model Contact {
  id        Int           @id @default(autoincrement())
  name      String
  email     String        @unique
  company   String
  goal      String
  status    ContactStatus @default(new)
  subject   String?
  body      String?
  createdAt DateTime      @default(now())
}
